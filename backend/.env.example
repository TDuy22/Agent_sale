# auto | gemini | openai | rule_based
# auto: dùng OpenAI nếu có key + model, sau đó tới Gemini, cuối cùng là rule-based.
# Khi provider LLM lỗi lúc chạy, backend tự dùng rule-based cho lượt đó.
SLOT_EXTRACTOR=auto

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Đường dẫn tương đối tính từ thư mục backend/.
FLOW_CONFIG_PATH=config/flow.yaml
PRICING_CONFIG_PATH=config/pricing.yaml
ASSET_CONFIG_PATH=assets/assets.yaml

# Origin được phép gọi API (JSON list).
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
